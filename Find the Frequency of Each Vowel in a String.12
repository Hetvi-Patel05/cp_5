#include <stdio.h>
#include <ctype.h>

int main()
{
    char str[200], ch;
    int i;
    int a = 0, e = 0, in = 0, o = 0, u = 0;

    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);

    for (i = 0; str[i] != '\0'; i++)
    {
        ch = tolower((unsigned char)str[i]);

        switch (ch)
        {
            case 'a': a++; break;
            case 'e': e++; break;
            case 'i': in++; break;
            case 'o': o++; break;
            case 'u': u++; break;
        }
    }

    printf("Frequency of a = %d\n", a);
    printf("Frequency of e = %d\n", e);
    printf("Frequency of i = %d\n", in);
    printf("Frequency of o = %d\n", o);
    printf("Frequency of u = %d\n", u);

    return 0;
}
